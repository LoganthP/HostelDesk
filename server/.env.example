# MongoDB Atlas connection string (Atlas → Connect → Drivers). Replace <user> and <password>.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name used inside the cluster
DB_NAME=hostel_cms
# Any long random string — used to sign the login cookie
SESSION_SECRET=replace-with-a-long-random-string
PORT=5000
NODE_ENV=development
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false
# Only needed if the frontend is hosted on a different origin than the API
# CLIENT_ORIGIN=http://localhost:5173
